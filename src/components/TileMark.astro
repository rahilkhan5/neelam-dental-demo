---
// One kashi tile: an eight point star in lapis on white glaze, turquoise
// quarter rounds in the corners (they meet as circles when tiles sit side by
// side). With initials it becomes a doctor's medallion.
interface Props {
  size?: number;
  initials?: string;
  class?: string;
}
const { size = 40, initials, class: className } = Astro.props;
const star = (r: number) => {
  const points: string[] = [];
  for (let i = 0; i < 16; i += 1) {
    const angle = (Math.PI / 8) * i - Math.PI / 2;
    const radius = i % 2 === 0 ? r : r * 0.72;
    points.push(`${(32 + radius * Math.cos(angle)).toFixed(2)},${(32 + radius * Math.sin(angle)).toFixed(2)}`);
  }
  return points.join(' ');
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect x="0.5" y="0.5" width="63" height="63" rx="5" fill="#fcfdfa" stroke="#c7d1ca" />
  <path d="M0.5 10.5 A10 10 0 0 0 10.5 0.5 H5.5 A5 5 0 0 1 0.5 5.5 Z" fill="#1f9a95" />
  <path d="M63.5 10.5 A10 10 0 0 1 53.5 0.5 H58.5 A5 5 0 0 0 63.5 5.5 Z" fill="#1f9a95" />
  <path d="M0.5 53.5 A10 10 0 0 1 10.5 63.5 H5.5 A5 5 0 0 0 0.5 58.5 Z" fill="#1f9a95" />
  <path d="M63.5 53.5 A10 10 0 0 0 53.5 63.5 H58.5 A5 5 0 0 1 63.5 58.5 Z" fill="#1f9a95" />
  <polygon points={star(26)} fill="#1d3a8a" />
  {
    initials ? (
      <>
        <circle cx="32" cy="32" r="15.5" fill="#fcfdfa" />
        <circle cx="32" cy="32" r="15.5" fill="none" stroke="#c9922e" stroke-width="1.5" />
        <text
          x="32"
          y="37.5"
          text-anchor="middle"
          font-family="Rozha One, Georgia, serif"
          font-size="15"
          fill="#172b6b"
        >
          {initials}
        </text>
      </>
    ) : (
      <>
        <polygon points={star(15)} fill="#9fd9d1" />
        <circle cx="32" cy="32" r="5" fill="#c9922e" />
      </>
    )
  }
</svg>
